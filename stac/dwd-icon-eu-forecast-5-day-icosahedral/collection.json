          "code": "import dynamical_catalog  # dynamical-catalog>=0.8.0\n\nds = dynamical_catalog.open(\"dwd-icon-eu-forecast-5-day-icosahedral\", chunks=None)\nds[\"temperature_2m\"].sel(init_time=\"2026-11-01T00\", cell=0).max()",
          "language": "python"
        },
        {
          "label": "pystac",
          "code": "import icechunk\nimport pystac\nimport xarray as xr\n\ncatalog = pystac.Catalog.from_file(\"https://stac.dynamical.org/catalog.json\")\ncollection = catalog.get_child(\"dwd-icon-eu-forecast-5-day-icosahedral\")\nasset = collection.assets[\"icechunk-https\"]\n\nrepo = icechunk.Repository.open(icechunk.http_storage(asset.href))\nsession = repo.readonly_session(\"main\")\n\nds = xr.open_zarr(session.store, chunks=None)\nds[\"temperature_2m\"].sel(init_time=\"2026-11-01T00\", cell=0).max()",
          "language": "python"
        },
